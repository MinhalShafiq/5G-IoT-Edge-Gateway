    {
      "title": "Telemetry Ingestion Rate by Protocol",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(telemetry_received_total[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Active Devices by Type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "active_devices",
          "legendFormat": "{{device_type}}"
        }
      ]
    },
    {
      "title": "Stream Throughput: Ingested vs Consumed",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(stream_messages_published_total[1m]))",
          "legendFormat": "published"
        },
        {
          "expr": "sum by (consumer_group) (rate(stream_messages_consumed_total[1m]))",
          "legendFormat": "consumed: {{consumer_group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Consumer Group Lag (undelivered entries)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "redis_consumer_group_lag",
          "legendFormat": "{{stream}} / {{consumer_group}}"
        }
      ]
    },
    {
      "title": "Anomalies Detected per Second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (device_type, severity) (rate(anomalies_detected_total[1m]))",
          "legendFormat": "{{device_type}} {{severity}}"
        }
      ]
    },
    {
      "title": "Redis Stream Lengths",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "redis_stream_length",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "title": "Ingestion Latency (p50 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(processing_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(processing_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "ML Inference Latency per Batch (p50 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "expr": "sum(rate(inference_batch_size_sum[5m])) / sum(rate(inference_batch_size_count[5m]))",
          "legendFormat": "avg batch size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
